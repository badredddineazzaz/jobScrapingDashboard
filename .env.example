# JobScraper backend configuration
# Copy this file to .env and replace secrets with real values where needed.

# Storage and application behavior
JOBSCRAPER_DATA_DIR=./data
JOBSCRAPER_DATABASE_URL=sqlite:///./data/jobscraper.db
JOBSCRAPER_LOG_LEVEL=INFO
JOBSCRAPER_OUTPUT_FORMAT=json
# Optional HTTP(S) proxy used by scraper integrations.
# JOBSCRAPER_PROXY_URL=http://localhost:8080

# Scraper enablement and request pacing
LINKEDIN_ENABLED=true
LINKEDIN_DELAY=2.0
LINKEDIN_USE_SELENIUM=false
LINKEDIN_HEADLESS=true

HELLOWORK_ENABLED=true
HELLOWORK_DELAY=2.0

FRANCE_TRAVAIL_ENABLED=true
FRANCE_TRAVAIL_DELAY=2.0

WTTJ_ENABLED=true
WTTJ_DELAY=1.0

# Optional Adzuna credentials.
# Leave empty/unset to skip Adzuna API searches.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Docker Compose only. Change this outside local development.
POSTGRES_PASSWORD=jobscraper-local
# Reserved for the external worker adapter; the durable scheduler currently
# dispatches through the API worker while schedules themselves live in SQL.
JOBSCRAPER_REDIS_URL=redis://localhost:6379/0
